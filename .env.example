# Application
APP_NAME=Events API
API_VERSION=1.0.0
ENVIRONMENT=local
DEBUG=True

# Database (Supabase PostgreSQL)
# Usar el Connection Pooler (Transaction mode, puerto 6543) en vez de la
# conexión directa: el host directo (db.<ref>.supabase.co) es IPv6-only y
# falla en redes sin salida IPv6. Obtener la cadena en Supabase:
# Project Settings > Database > Connection string > pestaña "Connection pooling".
# Formato: postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS: orígenes del frontend permitidos, separados por comas
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Email
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_FROM=